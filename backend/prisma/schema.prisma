generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Attendance_History {
  Attendance_ID Int      @id @default(autoincrement())
  Employee_ID   String
  Punch_Date    DateTime @db.Date
  Punch_In      DateTime @db.Time(0)
  Punch_Out     DateTime? @db.Time(0)
  Department    String
  Cost_Centre   String
  Source_File   String
  Import_Month  String

  @@map("Attendance_History")
}

model Employee_Department_Master {
  Employee_ID         String @id
  Official_Department String

  @@map("Employee_Department_Master")
}

model Employee_Pay_Rate {
  Employee_ID String  @id
  Hourly_Rate Decimal @db.Decimal(10, 4)

  @@map("Employee_Pay_Rate")
}

model Company_Master_Rules {
  Rule_Name   String  @id
  Value       Decimal @db.Decimal(10, 4)
  Description String

  @@map("Company_Master_Rules")
}

model Valid_Cost_Centres {
  Cost_Centre_Code String @id
  Description      String

  @@map("Valid_Cost_Centres")
}

model Valid_Departments {
  Department String @id

  @@map("Valid_Departments")
}

model Payroll_Extract {
  Record_ID    Int      @id @default(autoincrement())
  Employee_ID  String
  Department   String?
  Cost_Centre  String?
  Pay_Period   String
  Pay_Type     String
  Hours_Worked Decimal? @db.Decimal(10, 4)
  Pay_Amount   Decimal? @db.Decimal(10, 2)
  Source       String   @default("Generated")

  flaggedResults Flagged_Results[]

  @@map("Payroll_Extract")
}

model Flagged_Results {
  Flag_ID     Int    @id @default(autoincrement())
  Record_ID   Int
  Flag_Type   String
  Severity    String
  Description String @db.Text

  payrollRecord Payroll_Extract @relation(fields: [Record_ID], references: [Record_ID])

  @@map("Flagged_Results")
}

model Import_Log {
  Import_ID    Int      @id @default(autoincrement())
  Import_Month String
  Source_File  String
  Row_Count    Int
  Imported_At  DateTime @default(now())

  @@map("Import_Log")
}

model Users {
  Username String @id
  Password String
  Role     String

  @@map("Users")
}
